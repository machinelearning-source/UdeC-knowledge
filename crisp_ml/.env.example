# Example configuration for KnowBot Desk. Copy to .env (never commit .env) or set these on the host.

# Database: PostgreSQL in production. Without it, a local SQLite file is used (instance/knowbot_desk.db).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Signs the session cookies. Use a long random value; keep it the same across restarts.
SECRET_KEY=change-me-to-a-long-random-value

# Optional: written answers in the demo (Groq API key).
GROQ_API_KEY=

# Optional: test accounts created at start-up when they do not exist (give them privately to the instructor).
DESK_COORDINATOR_PASSWORD=
DESK_ADVISOR_PASSWORD=
DESK_STUDENT_PASSWORD=

# Optional: link to the presentation video shown on the homepage.
PROJECT_VIDEO_URL=
